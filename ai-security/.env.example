# BRIDGE-bench environment template.
# Copy to .env and fill in. .env is gitignored.

# ---------------------------------------------------------------------------
# DeepEval — fleet-wide invariant
# ---------------------------------------------------------------------------
# Blocks PostHog + Sentry telemetry that fires at deepeval import,
# and blocks the api.ipify.org public-IP fetch. Required for any usage
# per Adopt deepeval 2026-04-27.
DEEPEVAL_TELEMETRY_OPT_OUT=true

# Confident AI hosted dashboard — single fleet key (BRIDGE-bench Phase 1
# anchor + Phase 2/3 inheritors). Source: VW item Annunaki/deepeval/confident-ai-api-key.
# Resolve at runtime; never commit the literal value:
#   export CONFIDENT_API_KEY=$(rbw get --folder Annunaki/deepeval confident-ai-api-key)
# Unset CONFIDENT_API_KEY to fall back to local-only runs (no dashboard upload).
# CONFIDENT_API_KEY=

# ---------------------------------------------------------------------------
# Bifrost — every LLM call MUST route here. No direct provider calls.
# See ai-security/apo/run_config.py for the hard invariant.
# ---------------------------------------------------------------------------
BIFROST_URL=http://localhost:8090/v1
BIFROST_KEY=sk-bf-dev-interactive
BRIDGE_MODEL=anthropic/claude-sonnet-4-20250514

# Judge model — MUST differ from analyzer (AXI: separate-model judge rule).
# Defaults to openai/gpt-4o-mini in evals.judge_factory because:
#   1. Cheap + fast (G-Eval pilot ≈ $0.001 / case).
#   2. Bifrost's OpenAI-compat layer rejects response_format=json_schema for
#      anthropic/* models — G-Eval needs it. openai/* models accept it.
# Override only if you need a different judge:
# JUDGE_MODEL=openai/gpt-4o-mini

# ---------------------------------------------------------------------------
# Existing analyzer toggles (preserved for back-compat with apo/, agents/)
# ---------------------------------------------------------------------------
USE_BIFROST=1
# ANTHROPIC_API_KEY left unset — Bifrost holds the upstream credential.

# ---------------------------------------------------------------------------
# promptfoo (outer harness — adopted 2026-04-13)
# ---------------------------------------------------------------------------
PROMPTFOO_DISABLE_REMOTE_GENERATION=true
OPENAI_API_BASE_URL=http://localhost:8090/v1
